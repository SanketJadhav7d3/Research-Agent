server {
    # Cloud Run injects PORT; the Dockerfile defaults it to 8080 for local runs.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The charting library is a 4.8MB chunk uncompressed and about a quarter of
    # that gzipped, so this is the difference between a usable page and a slow
    # one. It is loaded on demand, but the demand is common enough to matter.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json application/xml
        image/svg+xml;

    # SPA: unknown paths fall through to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html names the hashed bundles, so it is the one file that must
    # never be served stale. With no Cache-Control at all a browser falls back
    # to heuristic caching and may reuse it without revalidating — which pins
    # that visitor to the previous deploy's JS forever, because the old
    # index.html only ever references the old hashed filenames. A deploy then
    # looks like it silently did nothing.
    #
    # no-cache means "revalidate", not "do not store": the ETag still makes
    # the common case a 304 with an empty body, so this costs a round trip
    # rather than a re-download.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Hashed filenames, so these can be cached hard and forever. Without this
    # the charting chunk is refetched on every visit.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Media served from the build root keeps its original name, so it must not
    # be marked immutable — replacing the demo video would leave cached clients
    # on the old one forever. A week is long enough to matter and short enough
    # to recover from. Not gzipped: mp4 is already compressed, and compressing
    # it again costs CPU to make it marginally larger.
    location ~* \.(mp4|webm|png|jpe?g|gif|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # Proxy API calls to the backend.
    #   Compose:    BACKEND_URL=http://backend:8080  (private network)
    #   Cloud Run:  BACKEND_URL=https://<backend>.run.app
    # Substituted at container start, so this stays a static value — no
    # runtime resolver needed.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;

        # Cloud Run routes by Host header, so it must name the backend, not
        # the frontend. $proxy_host is the host from proxy_pass above.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE-ready for the streaming endpoint in a later sprint.
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
