# --- LLM provider -----------------------------------------------------------
# Default provider. The deployed demo runs on Gemini so visitors need no key of
# their own. Users may supply their own OpenAI or Anthropic key per request.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.6-flash

# Required for the default provider. Free, no card:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional — only needed to run those providers from the server side.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Research tools ---------------------------------------------------------
TAVILY_API_KEY=
NEWSAPI_KEY=
E2B_API_KEY=
# Optional — unauthenticated calls work; a free key raises rate limits
JINA_API_KEY=

# --- Local dev --------------------------------------------------------------
BACKEND_URL=http://localhost:8080
